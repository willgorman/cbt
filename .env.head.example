# Environment variables for docker-compose.head.yml (Multi-Host Head Node)
# Copy this file to .env when using docker-compose.head.yml

# Docker image to use - can be local or from registry
# Use pre-built image from GitHub Container Registry:
#   CBT_IMAGE=ghcr.io/ceph/cbt:latest
# Or build locally (default):
#   CBT_IMAGE=cbt:latest
#CBT_IMAGE=ghcr.io/ceph/cbt:latest

# Hostname of the head node (will be set in container)
HEAD_HOSTNAME=cbt-head-host.example.com

# Directory containing ceph.conf and keyring files
# For multi-host, this should point to local ceph-config directory
CEPH_CONF_DIR=./ceph-config

# Directory containing SSH keys for accessing client nodes
# Should contain the private key (e.g., cbt_head_rsa)
SSH_KEY_DIR=./ssh-auth

# Directory where benchmark results will be stored
ARCHIVE_DIR=./archive

# Directory containing CBT YAML configuration files
CONFIG_DIR=./configs

# Optional: Custom PDSH SSH arguments
#PDSH_SSH_ARGS=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i /root/.ssh/cbt_head_rsa
