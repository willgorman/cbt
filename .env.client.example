# Environment variables for docker-compose.client.yml (Multi-Host Client Node)
# Copy this file to .env on each client host when using docker-compose.client.yml

# Hostname of this client node (should match what head node will use to connect)
# This should be the actual hostname or IP address of the host machine
# Examples:
#   CLIENT_HOSTNAME=client1.example.com
#   CLIENT_HOSTNAME=192.168.1.101
CLIENT_HOSTNAME=client1.example.com

# Directory containing ceph.conf and keyring files
# For multi-host, this is typically a local directory with copied config
CEPH_CONF_DIR=./ceph-config

# Directory containing the authorized_keys file
# This should contain the public key from the head node
SSH_AUTH_DIR=./ssh-auth

# Optional: Custom PDSH SSH arguments
#PDSH_SSH_ARGS=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
